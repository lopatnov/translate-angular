# Translate Studio — environment variables
# Copy this file to .env.local to override for your environment.
# All variables have sensible defaults that work out of the box.

# gRPC service address (host:port).
# Default: localhost:5100 — matches the Docker Compose setup in the main repo.
TRANSLATE_GRPC_URL=localhost:5100

# Express server port (SSR + API proxy).
# Default: 4000 — used in production / debug mode.
# ng serve (dev) always runs on port 4200 regardless of this value.
PORT=4000
